# Extra platform-admin emails (comma-separated). willyt87@gmail.com is always seeded.
# Also INSERT the same addresses into public.platform_admins so RLS lets them see every facility.
VITE_PLATFORM_ADMIN_EMAILS=

# Optional override for the public Binder project. Leave blank to use the product default.
# Operators can still change connection from /admin or /app#reconnect.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
